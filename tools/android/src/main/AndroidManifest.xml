<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <!-- Requested at runtime, in context, the first time a tool needs them. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- Shared storage. Android 10 and older use the two legacy permissions; 11 and newer use all files access, which the user turns on in settings. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <!-- The app is sideloaded from GitHub, not Play, so Play's all-files policy doesn't apply. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
    <!-- set_alarm and set_timer: the clock app takes them without opening; Android grants this at install. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
</manifest>
