      "boundElements": null,
      "updated": 1792439358945,
      "link": null,
      "locked": false,
      "text": "{\n  \"trigger\": { \"type\": \"bluetooth.connected\", \"device\": \"My Car\" },\n  \"conditions\": [{ \"type\": \"time.between\", \"from\": \"16:00\", \"to\": \"21:00\" }],\n  \"steps\": [{ \"action\": \"intent.navigate\", \"destination\": \"{{places.home}}\" },\n            { \"action\": \"media.play\" }],\n  \"approvedCapabilities\": [\"bluetooth.connect\", \"intent.navigate\", \"media.control\"]\n}",
      "originalText": "{\n  \"trigger\": { \"type\": \"bluetooth.connected\", \"device\": \"My Car\" },\n  \"conditions\": [{ \"type\": \"time.between\", \"from\": \"16:00\", \"to\": \"21:00\" }],\n  \"steps\": [{ \"action\": \"intent.navigate\", \"destination\": \"{{places.home}}\" },\n            { \"action\": \"media.play\" }],\n  \"approvedCapabilities\": [\"bluetooth.connect\", \"intent.navigate\", \"media.control\"]\n}",
      "fontSize": 15,
