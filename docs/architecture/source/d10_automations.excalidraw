      "boundElements": null,
      "updated": 1792439358945,
      "link": null,
      "locked": false,
      "text": "Reliable background triggers: time (WorkManager / exact alarm\nwith user grant), Bluetooth connect, place (background\nlocation), activity, calendar and photo changes, NFC, tile,\nwidget, shortcut, share, notification action.\n\nNot reliable in background: screen unlock, wired headphones.",
      "originalText": "Reliable background triggers: time (WorkManager / exact alarm\nwith user grant), Bluetooth connect, place (background\nlocation), activity, calendar and photo changes, NFC, tile,\nwidget, shortcut, share, notification action.\n\nNot reliable in background: screen unlock, wired headphones.",
      "fontSize": 16,
