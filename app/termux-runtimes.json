{
  "repository": "https://packages.termux.dev/apt/termux-main/",
  "termuxPrefix": "/data/data/com.termux/files/usr",
  "installDirectory": "rt",
  "packages": ["proot", "tar"],
  "abis": { "arm64-v8a": "aarch64" },
  "exclude": [
    "include/**",
    "share/man/**",
    "share/info/**",
    "share/doc/**",
    "share/locale/**",
    "lib/pkgconfig/**",
    "lib/*.a"
  ],
  "symlinks": {}
}
