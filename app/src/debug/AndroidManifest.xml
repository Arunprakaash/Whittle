<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only. Shell-only (DUMP permission): adb shell am broadcast -a app.whittle.debug.SEED_SAMPLE_CHATS -n app.whittle/.debug.SampleChatsReceiver -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".debug.SampleChatsReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="app.whittle.debug.SEED_SAMPLE_CHATS" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
