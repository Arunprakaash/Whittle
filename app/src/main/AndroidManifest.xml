<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Linux's DNS servers follow the phone's current network. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Only for the run-finished swell on Android 16+; every other haptic uses the view system. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Background tasks: a foreground service with an ongoing notification (a Live Update on Android 16). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- Speaking instead of typing in the chat; asked the first time the mic is tapped. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Automations: their alarms are set again after the phone restarts. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Installing the apps Whittle builds, only when the user taps Install on one; Android asks them to allow it first. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Remove on an app's card asks Android to uninstall it; without this, Android 9 refuses the request. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Android 11+ only shows the speech recognizer to apps that declare they use it. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".WhittleApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Whittle">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Whittle in Android's Share menu: what's shared opens a new chat, ready to send. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <!-- How the launcher icon's New chat and Speak and the Quick Settings tile reach MainActivity. MainActivity is
             exported, so another app could send it these actions; this alias isn't, so only Whittle's own shortcuts
             and tile (which start activities as Whittle) can use it. -->
        <activity-alias
            android:name=".QuickStartEntry"
            android:exported="false"
            android:targetActivity=".MainActivity" />
        <!-- Keeps a task the user started running while they are in another app; ends with the task. -->
        <service
            android:name=".background.AgentRunService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Finishes an AI agent task the user started in the app (model calls and tool steps), with a notification showing progress and a Stop button." />
        </service>
        <!-- Keeps Linux's setup (download, unpack, base packages) going while the user is in another app. -->
        <service
            android:name=".linux.LinuxSetupService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Downloads and sets up the Linux environment the user asked for, with a notification showing its progress." />
        </service>
        <!-- Keeps the one-time app-building setup (compiler and tools, about 400 MB) going while the user is in another app. -->
        <service
            android:name=".apps.AppToolchainService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Downloads and installs the tools for building apps that the user asked for, with a notification showing that it is working." />
        </service>
        <!-- Keeps servers the agent started running while the user is elsewhere, with Stop all; ends with them. -->
        <service
            android:name=".background.ProcessesService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps local development servers the user's AI agent started running, listed in a notification with a Stop all button." />
        </service>
        <!-- Automations: woken by their own alarms, and by the system to set those alarms again. Not exported;
             system broadcasts still arrive, and no other app can start a run. -->
        <receiver
            android:name=".automations.AutomationReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
        <!-- Shows a reminder when its alarm goes off; only Whittle's own alarms reach it. -->
        <receiver
            android:name=".reminders.ReminderReceiver"
            android:exported="false" />
        <!-- Whittle in Quick Settings: a tap opens a new chat. Only the system binds it. -->
        <service
            android:name=".quickstart.WhittleTileService"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="@string/quick_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- Approve or Decline on an approval's notification: answers the card, then closes. Its own task, so Whittle
             doesn't come forward; not exported, so only Whittle's own notifications open it. -->
        <activity
            android:name=".background.ApprovalActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- Whittle as the digital assistant (res/xml/assistant.xml). Only the system binds these. Android keeps the
             assistant service bound from boot while Whittle holds the role; it does nothing itself, so it waits in the
             light :recognizer process. The session service, which reads the screen and opens the chat, stays in
             Whittle's own process. -->
        <service
            android:name=".assistant.WhittleAssistantService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:process=":recognizer">
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/assistant" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>
        <service
            android:name=".assistant.AssistSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />
        <!-- The assistant must also be a speech recognizer; this one hands every request to one already installed. Exported
             with no permission on purpose: any app may ask the phone's recognizer to listen, as with every recognizer.
             In a process of its own, so dictation in other apps doesn't run Whittle's start-up work, and can't take
             running tasks down with it. -->
        <service
            android:name=".assistant.ForwardingRecognitionService"
            android:exported="true"
            android:label="@string/app_name"
            android:process=":recognizer"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
        <!-- Where the installer reports how an install went; only the system's PendingIntent reaches it. -->
        <receiver
            android:name=".apps.InstallResultReceiver"
            android:exported="false" />
        <!-- Connector sign-in pages send the user back here; the address matches redirectUri in connectors.json. -->
        <activity
            android:name=".connectors.ConnectorRedirectActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="app.whittle" android:host="oauth" />
            </intent-filter>
        </activity>
        <!-- The chats' workspaces as a location in Android's Files app. Only the system's document UI may bind. -->
        <provider
            android:name=".files.WorkspaceDocumentsProvider"
            android:authorities="${applicationId}.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
        <!-- Hands the camera app the one file to save a photo to; see res/xml/attachment_paths.xml. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.attachments"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/attachment_paths" />
        </provider>
        <!-- Crash reports from the apps Whittle builds. Exported with no permission on purpose: those apps have their own keys.
             AppCrashes accepts a report only from a Whittle-made package signed with the key Whittle holds for it. -->
        <provider
            android:name=".apps.AppCrashProvider"
            android:authorities="${applicationId}.apps.crashes"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />
    </application>
</manifest>
