{
  "schemaVersion": 1,
  "maxAutomations": 20,
  "maxNameChars": 60,
  "maxPromptChars": 2000,
  "defaultMinuteOfDay": 420,
  "retryAfterMillis": 300000,
  "giveUpAfterMillis": 10800000,
  "startTimeoutMillis": 10000,
  "alwaysPreApproved": ["ask_user", "update_plan"],
  "events": {
    "cooldownMillis": 120000,
    "maxRunsPerDay": 30,
    "maxQueued": 20,
    "minIntervalMinutes": 15,
    "defaultEveryMinutes": 60,
    "placeCheckMinutes": 15,
    "placePolling": false,
    "defaultPlaceRadiusMeters": 200,
    "minPlaceRadiusMeters": 100,
    "maxPlaceNameChars": 40,
    "maxNumberDigits": 6,
    "locationTimeoutMillis": 30000,
    "maxNotificationKeys": 200,
    "senderSuffixDigits": 8,
    "placeEventWords": ["place", "arrive", "leave", "place_arrive", "place_leave", "arrive_place", "leave_place", "home"],
    "capabilities": {
      "sms": ["sms"],
      "notification": ["notification_access"],
      "place": ["location", "location_background"],
      "wifi": ["location"]
    },
    "messageDefaultTools": ["clock"],
    "maxEventChars": 2000,
    "codeMask": {
      "keywords": ["otp", "code", "verification", "verify", "pin", "password", "passcode", "one time", "one-time", "2fa", "login"],
      "codePattern": "\\b(?:[A-Z]-)?(?:\\d{4,8}|\\d{3}[- ]\\d{3})\\b",
      "mixedCodePattern": "\\b(?:[A-Z]{1,3}-)?(?=[A-Z0-9]{4,10}\\b)(?=[A-Z0-9]*\\d)(?=[A-Z0-9]*[A-Z])[A-Z0-9]+\\b",
      "messagingApps": ["com.whatsapp", "com.whatsapp.w4b", "org.telegram.messenger", "com.google.android.apps.messaging", "com.samsung.android.messaging", "com.android.mms", "com.facebook.orca", "org.thoughtcrime.securesms"],
      "nearChars": 40,
      "amountPattern": "[\\d,]+\\.\\d{2}",
      "datePattern": "\\d{2}[-/]\\d{2}[-/]\\d{2,4}",
      "currencyBeforePattern": "(?<!\\p{L})(?:rs\\.?|₹|inr)\\s*$",
      "loneCodeDigits": 6,
      "shortMessageWords": 12
    }
  },
  "tools": [
    {
      "key": "web",
      "icon": "travel_explore",
      "label": "Read web pages",
      "toolIds": ["web_fetch"],
      "default": true
    },
    {
      "key": "clock",
      "icon": "schedule",
      "label": "Check the date and time",
      "toolIds": ["device_clock_now"],
      "default": true
    },
    {
      "key": "calendar",
      "icon": "calendar_month",
      "label": "Read your calendar",
      "toolIds": ["calendar_events"],
      "default": false
    },
    {
      "key": "health",
      "icon": "health_connect",
      "label": "Read your health data",
      "toolIds": ["health_data"],
      "capabilities": ["health", "health_background"],
      "default": false
    },
    {
      "key": "contacts",
      "icon": "contacts",
      "label": "Look up your contacts",
      "toolIds": ["contacts_search"],
      "default": false
    },
    {
      "key": "readFiles",
      "icon": "folder",
      "label": "Read files in the workspace",
      "labelInProject": "Read files in its project",
      "toolIds": ["list_files", "read_file"],
      "default": true
    },
    {
      "key": "changeFiles",
      "icon": "edit_document",
      "label": "Change files anywhere in the workspace, every project",
      "labelInProject": "Change files in its project",
      "toolIds": ["write_file", "edit_file"],
      "default": false,
      "writes": true
    }
  ],
  "ideas": [
    {
      "icon": "health_connect",
      "name": "Weekly health check-in",
      "prompt": "Compare this week's sleep, steps and workouts with last week's, and tell me one thing to change.",
      "minuteOfDay": 480,
      "days": [7],
      "tools": ["clock", "health"]
    },
    {
      "icon": "wb_sunny",
      "name": "Morning brief",
      "prompt": "Look at today's calendar and the top tech headlines, then give me a five-line brief with anything I should prepare for.",
      "minuteOfDay": 450,
      "days": [1, 2, 3, 4, 5],
      "tools": ["web", "clock", "calendar"]
    },
    {
      "icon": "bedtime",
      "name": "Tomorrow at a glance",
      "prompt": "Look at tomorrow's calendar and tell me, in three lines, when my day starts, what needs preparing tonight, and any gap for a break.",
      "minuteOfDay": 1260,
      "days": [7, 1, 2, 3, 4],
      "tools": ["clock", "calendar"]
    },
    {
      "icon": "newspaper",
      "name": "News on a topic",
      "prompt": "Find the three most important news stories from the last day on my topic, each in one line with its source. My topic is: ",
      "minuteOfDay": 480,
      "days": [1, 2, 3, 4, 5, 6, 7],
      "tools": ["web", "clock"]
    },
    {
      "icon": "summarize",
      "name": "Weekly summary of a project",
      "prompt": "Read this project's files and summarize what it does and what changed recently, in a short list.",
      "minuteOfDay": 1080,
      "days": [5],
      "tools": ["clock", "readFiles"]
    },
    {
      "icon": "monitor_heart",
      "name": "Check a site is up",
      "prompt": "Open my website and tell me whether it loads and anything that looks broken. My website is: ",
      "minuteOfDay": 540,
      "days": [1, 2, 3, 4, 5, 6, 7],
      "tools": ["web"]
    },
    {
      "icon": "payments",
      "name": "Log bank texts",
      "prompt": "A bank text just arrived. From it, take the date, the amount, the merchant and whether it was a debit or a credit, and append them as one CSV line (date,amount,merchant,debit or credit) to expenses.csv. If expenses.csv doesn't exist, create it first with the header date,amount,merchant,type. Never mention or log any code or one-time password.",
      "trigger": {"type": "sms", "senders": [], "words": ["debited", "credited", "spent"], "senderRequired": true},
      "tools": ["readFiles"]
    },
    {
      "icon": "package_2",
      "name": "What's arriving",
      "prompt": "A text about a delivery just arrived. Tell me in one line what is arriving, from whom, and when.",
      "trigger": {"type": "sms", "words": ["delivered", "out for delivery", "arriving", "shipped"]},
      "tools": []
    },
    {
      "icon": "battery_charging_full",
      "name": "Plugged in at night",
      "prompt": "Check the time. Only if it's after 9 PM, look at tomorrow's calendar and reminders and tell me, in three lines, the first events and reminders. If it's not after 9 PM, say nothing and stop.",
      "trigger": {"type": "charging", "edge": "START"},
      "tools": ["calendar", "clock"]
    }
  ]
}
