{
  "schemaVersion": 1,
  "hardDeny": [],
  "rules": [
    {
      "id": "memory-after-outside-content-confirms",
      "effect": "ASK",
      "matcher": { "toolIdPattern": "remember" },
      "whenTainted": true
    },
    {
      "id": "message-drafts-always-confirm",
      "effect": "ASK",
      "matcher": {
        "toolIdPattern": "compose_message"
      }
    },
    {
      "id": "calls-always-confirm",
      "effect": "ASK",
      "matcher": {
        "toolIdPattern": "call"
      }
    },
    {
      "id": "connections-always-confirm",
      "effect": "ASK",
      "matcher": {
        "toolIdPattern": "add_connection"
      }
    },
    {
      "id": "automations-always-confirm",
      "effect": "ASK",
      "matcher": {
        "toolIdPattern": "schedule_task"
      }
    }
  ],
  "riskTierDefaults": {
    "READ": "ALLOW",
    "WORKSPACE": "ALLOW",
    "WEB_READ": "ALLOW",
    "WRITE_LOCAL": "ALLOW",
    "NETWORK_OUT": "ASK_ONCE",
    "SEND_OR_SHARE": "ASK_EVERY_TIME",
    "DELETE_OR_PAY": "ASK_EVERY_TIME"
  },
  "trustTierLimits": {
    "A": {
      "deniedRiskTiers": [],
      "askEveryTimeFrom": "SEND_OR_SHARE"
    },
    "B": {
      "deniedRiskTiers": [],
      "askEveryTimeFrom": "NETWORK_OUT"
    },
    "C": {
      "deniedRiskTiers": [
        "SEND_OR_SHARE",
        "DELETE_OR_PAY"
      ],
      "askEveryTimeFrom": "WRITE_LOCAL"
    }
  }
}
