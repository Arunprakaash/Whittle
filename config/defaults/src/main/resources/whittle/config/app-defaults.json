{
  "schemaVersion": 1,
  "appearance": {
    "wallpaperColors": false,
    "haptics": true
  },
  "storage": {
    "connectionStoreName": "whittle_connection",
    "settingsStoreName": "whittle_settings",
    "runsDatabaseName": "whittle_runs.db",
    "chatsDatabaseName": "whittle_chats.db",
    "workspacesDirectoryName": "workspaces"
  },
  "terminal": {
    "shell": "/system/bin/sh",
    "path": "/system/bin"
  },
  "toolRuntime": {
    "enabled": true,
    "cacheDirectoryName": "tool-caches",
    "environment": {
      "PATH": "{{prefix}}/bin:{{systemPath}}",
      "SSL_CERT_FILE": "{{prefix}}/etc/tls/cert.pem",
      "npm_config_cache": "{{cacheDir}}/npm",
      "npm_config_update_notifier": "false",
      "npm_config_fund": "false",
      "npm_config_audit": "false",
      "PIP_CACHE_DIR": "{{cacheDir}}/pip",
      "PIP_DISABLE_PIP_VERSION_CHECK": "1",
      "GIT_PAGER": "cat",
      "PAGER": "cat",
      "LANG": "en_US.UTF-8"
    },
    "shellFunctions": [
      "npm() { node \"{{prefix}}/lib/node_modules/npm/bin/npm-cli.js\" \"$@\"; }",
      "npx() { node \"{{prefix}}/lib/node_modules/npm/bin/npx-cli.js\" \"$@\"; }",
      "pip() { python3 -m pip \"$@\"; }",
      "pip3() { python3 -m pip \"$@\"; }"
    ]
  },
  "chatList": {
    "sidebarMaxChats": 25
  },
  "siteIcons": {
    "enabled": true,
    "cacheDirectoryName": "site-icons",
    "sizePx": 96,
    "maxPageBytes": 131072,
    "maxIconBytes": 262144,
    "memoryEntries": 64
  },
  "artifacts": {
    "domainSuffix": "artifacts.whittle.invalid",
    "sharedDirectoryName": "shared-artifacts",
    "sheetHeightFraction": 0.88,
    "maxInlineBytes": 4194304
  }
}
