{
  "schemaVersion": 1,
  "appearance": {
    "wallpaperColors": false,
    "themeMode": "System",
    "haptics": true
  },
  "storage": {
    "connectionStoreName": "whittle_connection",
    "settingsStoreName": "whittle_settings",
    "runsDatabaseName": "whittle_runs.db",
    "chatsDatabaseName": "whittle_chats.db",
    "workspacesDirectoryName": "workspaces",
    "connectorsDirectoryName": "connectors",
    "customConnectorsStoreName": "whittle_connectors"
  },
  "terminal": {
    "shell": "/system/bin/sh",
    "path": "/system/bin"
  },
  "toolRuntime": {
    "enabled": true,
    "cacheDirectoryName": "tool-caches",
    "environment": {
      "PATH": "{{prefix}}/bin:{{systemPath}}",
      "SSL_CERT_FILE": "{{prefix}}/etc/tls/cert.pem",
      "npm_config_cache": "{{cacheDir}}/npm",
      "npm_config_update_notifier": "false",
      "npm_config_fund": "false",
      "npm_config_audit": "false",
      "PIP_CACHE_DIR": "{{cacheDir}}/pip",
      "PIP_DISABLE_PIP_VERSION_CHECK": "1",
      "GIT_PAGER": "cat",
      "PAGER": "cat",
      "LANG": "en_US.UTF-8"
    },
    "shellFunctions": [
      "npm() { node \"{{prefix}}/lib/node_modules/npm/bin/npm-cli.js\" \"$@\"; }",
      "npx() { node \"{{prefix}}/lib/node_modules/npm/bin/npx-cli.js\" \"$@\"; }",
      "pip() { python3 -m pip \"$@\"; }",
      "pip3() { python3 -m pip \"$@\"; }"
    ]
  },
  "chatList": {
    "sidebarMaxChats": 25
  },
  "siteIcons": {
    "enabled": true,
    "cacheDirectoryName": "site-icons",
    "sizePx": 96,
    "maxPageBytes": 524288,
    "maxIconBytes": 262144,
    "memoryEntries": 64
  },
  "export": {
    "packagePrefix": "app.whittle.apps",
    "maxNameChars": 24,
    "maxLabelChars": 30,
    "labelSeparators": [
      " — ",
      " – ",
      " | ",
      ": ",
      " - "
    ],
    "signingKeyAlias": "whittle_export_signing",
    "certificateSubject": "CN=Whittle Apps",
    "certificateValidityYears": 30,
    "iconSizePx": 432,
    "iconColors": [
      "#2E6B57",
      "#3F5F99",
      "#8A4F7D",
      "#B0603A",
      "#4F7A2E",
      "#6B5BA8",
      "#2F7F8C",
      "#9A4A4A"
    ],
    "maxAppBytes": 52428800,
    "workDirectoryName": "export"
  },
  "background": {
    "keepRunning": true
  },
  "artifacts": {
    "domainSuffix": "artifacts.whittle.invalid",
    "sharedDirectoryName": "shared-artifacts",
    "sheetHeightFraction": 0.88,
    "maxInlineBytes": 4194304
  },
  "voice": {
    "preferOnDevice": true,
    "silenceMillis": 2000,
    "stopGraceMillis": 2500,
    "busyRetryMillis": 400
  },
  "memory": {
    "fileName": "memory.bin"
  }
}
