{
  "schemaVersion": 1,
  "appearance": {
    "wallpaperColors": false,
    "themeMode": "System",
    "haptics": true
  },
  "storage": {
    "connectionStoreName": "whittle_connection",
    "settingsStoreName": "whittle_settings",
    "runsDatabaseName": "whittle_runs.db",
    "chatsDatabaseName": "whittle_chats.db",
    "workspacesDirectoryName": "workspaces",
    "connectorsDirectoryName": "connectors",
    "customConnectorsStoreName": "whittle_connectors"
  },
  "terminal": {
    "shell": "/system/bin/sh",
    "path": "/system/bin"
  },
  "toolRuntime": {
    "cacheDirectoryName": "proot-tmp",
    "environment": {
      "PATH": "{{prefix}}/bin:{{systemPath}}",
      "PROOT_LOADER": "{{prefix}}/libexec/proot/loader",
      "PROOT_TMP_DIR": "{{cacheDir}}"
    }
  },
  "chatList": {
    "sidebarMaxChats": 25
  },
  "siteIcons": {
    "enabled": true,
    "cacheDirectoryName": "site-icons",
    "sizePx": 96,
    "maxPageBytes": 524288,
    "maxIconBytes": 262144,
    "memoryEntries": 64
  },
  "export": {
    "packagePrefix": "app.whittle.apps",
    "maxNameChars": 24,
    "maxLabelChars": 30,
    "labelSeparators": [
      " — ",
      " – ",
      " | ",
      ": ",
      " - "
    ],
    "signingKeyAlias": "whittle_export_signing",
    "certificateSubject": "CN=Whittle Apps",
    "certificateValidityYears": 30,
    "iconSizePx": 432,
    "iconColors": [
      "#2E6B57",
      "#3F5F99",
      "#8A4F7D",
      "#B0603A",
      "#4F7A2E",
      "#6B5BA8",
      "#2F7F8C",
      "#9A4A4A"
    ],
    "maxAppBytes": 52428800,
    "workDirectoryName": "export"
  },
  "background": {
    "keepRunning": true
  },
  "apps": {
    "domainSuffix": "artifacts.whittle.invalid",
    "sharedDirectoryName": "shared-apps",
    "sheetHeightFraction": 0.88,
    "maxInlineBytes": 4194304
  },
  "voice": {
    "preferOnDevice": true,
    "silenceMillis": 2000,
    "stopGraceMillis": 2500,
    "busyRetryMillis": 400
  },
  "memory": {
    "fileName": "memory.bin"
  }
}
