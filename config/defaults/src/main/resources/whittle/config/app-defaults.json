{
  "schemaVersion": 1,
  "appearance": {
    "wallpaperColors": false,
    "themeMode": "System",
    "haptics": true
  },
  "storage": {
    "connectionStoreName": "whittle_connection",
    "settingsStoreName": "whittle_settings",
    "runsDatabaseName": "whittle_runs.db",
    "chatsDatabaseName": "whittle_chats.db",
    "workspaceDirectoryName": "workspace",
    "connectorsDirectoryName": "connectors",
    "customConnectorsStoreName": "whittle_connectors",
    "chatProjectsFileName": "chat-projects.json",
    "automationsFileName": "automations.enc"
  },
  "terminal": {
    "shell": "/system/bin/sh",
    "path": "/system/bin"
  },
  "toolRuntime": {
    "cacheDirectoryName": "proot-tmp",
    "environment": {
      "PATH": "{{prefix}}/bin:{{systemPath}}",
      "PROOT_LOADER": "{{prefix}}/libexec/proot/loader",
      "PROOT_TMP_DIR": "{{cacheDir}}"
    }
  },
  "chatList": {
    "sidebarMaxChats": 25
  },
  "siteIcons": {
    "enabled": true,
    "cacheDirectoryName": "site-icons",
    "sizePx": 96,
    "maxPageBytes": 524288,
    "maxIconBytes": 262144,
    "memoryEntries": 64
  },
  "background": {
    "keepRunning": true,
    "approvals": {
      "fromNotification": true,
      "inAppOnly": ["DELETE_OR_PAY"]
    }
  },
  "projects": {
    "promptWithProject": "This chat works on the project {{project}}, in {{mount}}/{{project}}: commands start there and relative paths resolve inside it.",
    "promptWithoutProject": "This chat has no project yet: commands start in {{mount}}.",
    "recentCount": 3
  },
  "files": {
    "changesDirectoryName": "file-changes",
    "hiddenNames": [".whittle"],
    "maxPreviewChars": 200000,
    "maxImageSidePx": 2048,
    "diffContextLines": 3,
    "maxDiffCells": 4000000,
    "folderIcon": "folder",
    "defaultFileIcon": "description",
    "fileIcons": {
      "ts": "code", "tsx": "code", "js": "code", "jsx": "code", "mjs": "code", "cjs": "code", "kt": "code",
      "java": "code", "py": "code", "rb": "code", "go": "code", "rs": "code", "c": "code", "h": "code",
      "cpp": "code", "swift": "code", "sql": "code", "sh": "terminal", "bash": "terminal",
      "css": "palette", "scss": "palette", "less": "palette", "html": "html", "htm": "html",
      "json": "data_object", "md": "description", "txt": "description", "csv": "description",
      "png": "image", "jpg": "image", "jpeg": "image", "gif": "image", "webp": "image", "svg": "image", "bmp": "image", "pdf": "picture_as_pdf",
      "zip": "folder_zip", "gz": "folder_zip", "tgz": "folder_zip", "tar": "folder_zip", "7z": "folder_zip", "rar": "folder_zip",
      "toml": "settings", "yaml": "settings", "yml": "settings", "ini": "settings", "conf": "settings", "lock": "settings", "env": "settings"
    },
    "imageExtensions": ["png", "jpg", "jpeg", "gif", "webp", "bmp"],
    "proseExtensions": ["md", "markdown", "txt", "csv", "log", "rst"],
    "pdfExtensions": ["pdf"],
    "keywords": [
      "import", "export", "from", "default", "const", "let", "var", "function", "return", "if", "else", "for", "while",
      "class", "extends", "new", "async", "await", "try", "catch", "throw", "true", "false", "null", "undefined",
      "def", "fun", "val", "in", "not", "and", "or", "None", "True", "False", "self", "this", "type", "interface"
    ],
    "lineComments": {
      "//": ["ts", "tsx", "js", "jsx", "mjs", "cjs", "kt", "java", "go", "rs", "c", "h", "cpp", "swift", "scss", "less"],
      "#": ["py", "rb", "sh", "bash", "yaml", "yml", "toml", "conf", "ini", "env"]
    }
  },
  "preview": {
    "sheetHeightFraction": 0.88
  },
  "voice": {
    "preferOnDevice": true,
    "silenceMillis": 2000,
    "stopGraceMillis": 2500,
    "busyRetryMillis": 400
  },
  "memory": {
    "fileName": "memory.bin",
    "ideas": [
      { "icon": "person", "title": "What to call you", "example": "“Call me Sam.”", "start": "Call me " },
      { "icon": "language", "title": "Units and language", "example": "“Use metric units and British English.”", "start": "Use " },
      { "icon": "short_text", "title": "How you like answers", "example": "“Short, main point first.”", "start": "I like answers that are " }
    ]
  },
  "starters": [
    { "icon": "calendar_month", "title": "What's on today", "prompt": "What's on my calendar today?", "feature": "calendar" },
    { "icon": "alarm", "title": "A reminder", "prompt": "Remind me to stretch in 30 minutes.", "feature": "reminders" },
    { "icon": "sms", "title": "A quick text", "prompt": "Draft a text saying I'm running 10 minutes late." }
  ],
  "appIdeas": [
    { "icon": "checklist", "title": "Habit tracker", "prompt": "Make me an Android app to tick off three daily habits, with a streak for each." },
    { "icon": "calculate", "title": "Tip calculator", "prompt": "Make me an Android app that splits a bill and the tip between friends." },
    { "icon": "storefront", "title": "A page for my shop", "prompt": "Build a one-page website for my small shop, with opening hours and a map link. My shop is: " }
  ],
  "assistant": {
    "waitMillis": 2000,
    "screenshotFileName": "assist-screen.jpg"
  },
  "attachments": {
    "directoryName": "uploads",
    "maxPerMessage": 5,
    "maxFileBytes": 20971520,
    "imageMaxSidePx": 1568,
    "imageJpegQuality": 85,
    "thumbnailSidePx": 256,
    "memoryEntries": 24,
    "cameraDirectoryName": "camera"
  },
  "updates": {
    "check": true,
    "latestReleaseUrl": "https://api.github.com/repos/Arunprakaash/Whittle/releases/latest",
    "apkPattern": "^Whittle-.*\\.apk$",
    "everyHours": 24,
    "fileName": "update-check.json"
  }
}
