{
  "schemaVersion": 1,
  "agent": {
    "maxStepsPerRun": 25,
    "maxOutputTokensPerStep": 4096,
    "tokenBudgetPerRun": 400000,
    "maxToolOutputChars": 20000,
    "maxPlanItems": 12
  },
  "network": {
    "connectTimeoutMillis": 15000,
    "readTimeoutMillis": 120000,
    "writeTimeoutMillis": 30000
  },
  "telemetry": {
    "defaultConsent": "METADATA",
    "posthogHost": "https://us.i.posthog.com",
    "maxAttributeChars": 2000,
    "sessionReplay": {
      "enabled": true,
      "screenshotMode": true,
      "maskAllText": true,
      "maskAllImages": true,
      "captureTouches": true,
      "captureLogcat": false,
      "sampleRate": 1.0
    }
  },
  "secrets": {
    "dataStoreName": "whittle_secrets",
    "keysetName": "whittle_secrets_keyset",
    "keysetPreferencesFile": "whittle_secrets_keyset_prefs",
    "masterKeyUri": "android-keystore://whittle_secrets_master_key",
    "keyTemplate": "AES256_GCM"
  }
}
