{
  "schemaVersion": 1,
  "defaultOutDir": "dist",
  "entryExtensions": [".tsx", ".ts", ".jsx", ".js", ".mts", ".mjs"],
  "pageExtensions": [".html", ".htm"],
  "resolveExtensions": [".tsx", ".ts", ".jsx", ".js", ".mts", ".mjs", ".css", ".json"],
  "loaders": {
    ".ts": "ts",
    ".mts": "ts",
    ".cts": "ts",
    ".tsx": "tsx",
    ".js": "js",
    ".mjs": "js",
    ".cjs": "js",
    ".jsx": "jsx",
    ".css": "css",
    ".json": "json",
    ".txt": "text",
    ".md": "text",
    ".svg": "dataurl",
    ".png": "dataurl",
    ".jpg": "dataurl",
    ".jpeg": "dataurl",
    ".gif": "dataurl",
    ".webp": "dataurl",
    ".avif": "dataurl",
    ".ico": "dataurl",
    ".woff": "dataurl",
    ".woff2": "dataurl",
    ".ttf": "dataurl",
    ".mp3": "dataurl",
    ".wav": "dataurl"
  },
  "esbuildOptions": {
    "target": "es2022",
    "format": "esm",
    "jsx": "automatic",
    "minify": true,
    "charset": "utf8",
    "legalComments": "none",
    "define": { "process.env.NODE_ENV": "\"production\"" }
  },
  "moduleOutput": true,
  "packages": {
    "baseUrl": "https://esm.sh",
    "query": "target=es2022",
    "manifestFile": "package.json",
    "manifestFields": ["dependencies", "devDependencies", "peerDependencies"],
    "allowedHosts": ["esm.sh", "cdn.jsdelivr.net", "unpkg.com"],
    "maxModuleBytes": 8388608
  },
  "ignoredDirectories": ["node_modules", ".git"],
  "maxSourceFiles": 2000,
  "maxMessages": 20,
  "timeoutSeconds": 120,
  "host": {
    "domain": "build.whittle.invalid",
    "assetDirectory": "web-build",
    "page": "index.html",
    "cacheDirectoryName": "web-build-modules",
    "cacheMaxBytes": 67108864,
    "idleShutdownSeconds": 300
  }
}
