{
  "schemaVersion": 1,
  "enabled": true,
  "providerId": "claude-code",
  "displayName": "Claude Code",
  "sessionsFileName": "claude-code-sessions.json",
  "updatedStampFileName": "claude-code-updated.txt",
  "installCommand": "install -d -m 0755 /etc/apt/keyrings && curl -fsSL https://downloads.claude.ai/keys/claude-code.asc -o /etc/apt/keyrings/claude-code.asc && echo 'deb [signed-by=/etc/apt/keyrings/claude-code.asc] https://downloads.claude.ai/claude-code/apt/stable stable main' > /etc/apt/sources.list.d/claude-code.list && apt-get update -q && apt-get install -y -q claude-code && apt-get clean",
  "removeCommand": "apt-get remove -y -q claude-code && rm -f /etc/apt/sources.list.d/claude-code.list /etc/apt/keyrings/claude-code.asc",
  "updateCommand": "apt-get update -q -o Dir::Etc::sourcelist=sources.list.d/claude-code.list -o Dir::Etc::sourceparts=- -o APT::Get::List-Cleanup=0 && apt-get install -y -q --only-upgrade claude-code && apt-get clean",
  "versionCommand": "claude --version",
  "statusCommand": "claude auth status",
  "signInCommand": "claude auth login",
  "signOutCommand": "claude auth logout",
  "signInMethods": [
    {
      "id": "plan",
      "name": "Claude plan",
      "detail": "Pro, Max, Team or Enterprise",
      "icon": "person",
      "arguments": "--claudeai"
    },
    {
      "id": "console",
      "name": "Anthropic Console",
      "detail": "Billed to your API usage",
      "icon": "payments",
      "arguments": "--console"
    }
  ],
  "apiKey": {
    "name": "Anthropic API key",
    "detail": "Kept encrypted on this phone",
    "icon": "key",
    "secretName": "claude_code_api_key",
    "checkUrl": "https://api.anthropic.com/v1/models",
    "keyHeader": "x-api-key",
    "checkHeaders": {
      "anthropic-version": "2023-06-01"
    },
    "keysUrl": "https://console.anthropic.com/settings/keys",
    "runPrefix": "export ANTHROPIC_API_KEY=\"$(cat {{file}})\" && rm -f {{file}} &&"
  },
  "runCommand": "claude -p --input-format stream-json --output-format stream-json --verbose --include-partial-messages --permission-prompt-tool stdio --model {{model}}",
  "resumeArguments": "--resume {{session}}",
  "allowedToolsArguments": "--allowedTools {{tools}}",
  "preApprovedTools": {
    "web_fetch": [
      "WebFetch"
    ],
    "list_files": [
      "Glob",
      "Grep"
    ],
    "read_file": [
      "Read"
    ],
    "write_file": [
      "Write"
    ],
    "edit_file": [
      "Edit",
      "MultiEdit"
    ]
  },
  "fileArguments": {
    "Write": "file_path",
    "Edit": "file_path",
    "MultiEdit": "file_path",
    "NotebookEdit": "notebook_path"
  },
  "mcpConfigArguments": "--mcp-config {{file}}",
  "disallowedToolsArguments": "--disallowedTools {{tools}}",
  "mcpToolName": "mcp__{{server}}__{{tool}}",
  "mcpTransports": {
    "STREAMABLE_HTTP": "http",
    "SSE": "sse"
  },
  "taskFilesDirectory": "/root/.whittle",
  "installTimeoutSeconds": 900,
  "updateEveryHours": 24,
  "commandTimeoutSeconds": 60,
  "inboxPollMillis": 200,
  "signedOutErrors": [
    "authentication_failed",
    "oauth_org_not_allowed"
  ],
  "limitErrors": [
    "rate_limit",
    "billing_error"
  ],
  "limitNames": {
    "five_hour": "5-hour",
    "seven_day": "weekly",
    "seven_day_opus": "weekly Opus",
    "seven_day_sonnet": "weekly Sonnet"
  },
  "planNames": {
    "pro": "Pro",
    "max": "Max",
    "team": "Team",
    "enterprise": "Enterprise"
  },
  "declinedMessage": "The user didn't allow this step. Don't try it again; carry on without it or ask the user.",
  "outputChars": 20000,
  "models": [
    {
      "id": "opus",
      "name": "Opus",
      "detail": "Most capable"
    },
    {
      "id": "sonnet",
      "name": "Sonnet",
      "detail": "Fast and capable"
    },
    {
      "id": "haiku",
      "name": "Haiku",
      "detail": "Fastest"
    }
  ]
}
