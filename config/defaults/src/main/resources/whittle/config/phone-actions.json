{
  "schemaVersion": 1,
  "maps": {
    "searchUri": "geo:0,0?q={{query}}",
    "directionsUri": "https://www.google.com/maps/dir/?api=1&destination={{destination}}&travelmode={{mode}}"
  },
  "reminders": {
    "fileName": "reminders.bin",
    "maxReminders": 100,
    "maxTextChars": 300
  },
  "share": {
    "directoryName": "share",
    "maxFileBytes": 52428800
  },
  "health": {
    "providerPackage": "com.google.android.apps.healthdata",
    "installUri": "market://details?id={{package}}&url=healthconnect%3A%2F%2Fonboarding",
    "defaultDays": 7,
    "maxDays": 366,
    "maxHourlyDays": 2,
    "maxRecords": 200
  },
  "storage": {
    "maxFolders": 10,
    "scanMillis": 8000,
    "maxResults": 200,
    "oldDays": 90,
    "maxHashBytes": 2147483648,
    "maxDeletePerCall": 50,
    "protectedFolders": ["Android/data", "Android/obb", "Android/media"],
    "types": {
      "image": ["jpg", "jpeg", "png", "gif", "webp", "heic", "heif", "bmp", "raw", "dng"],
      "video": ["mp4", "mkv", "mov", "avi", "webm", "3gp", "m4v"],
      "audio": ["mp3", "m4a", "aac", "wav", "flac", "ogg", "opus", "amr"],
      "document": ["pdf", "doc", "docx", "xls", "xlsx", "ppt", "pptx", "txt", "rtf", "odt", "csv", "epub"],
      "apk": ["apk", "apks", "xapk"],
      "archive": ["zip", "rar", "7z", "tar", "gz", "bz2", "xz"]
    }
  },
  "switches": [
    {
      "id": "contacts",
      "icon": "contacts",
      "title": "Contacts",
      "capabilities": [
        "contacts"
      ],
      "tools": [
        "contacts_search"
      ]
    },
    {
      "id": "calendar",
      "icon": "calendar_month",
      "title": "Calendar",
      "capabilities": [
        "calendar"
      ],
      "tools": [
        "calendar_events"
      ]
    },
    {
      "id": "calendar_write",
      "icon": "event",
      "title": "Add to calendar",
      "capabilities": [
        "calendar",
        "calendar_write"
      ],
      "tools": [
        "add_calendar_event"
      ]
    },
    {
      "id": "health",
      "icon": "health_connect",
      "title": "Health",
      "capabilities": [
        "health"
      ],
      "tools": [
        "health_data"
      ]
    },
    {
      "id": "alarms",
      "icon": "alarm",
      "title": "Alarms and timers",
      "capabilities": [],
      "tools": [
        "set_alarm",
        "set_timer"
      ]
    },
    {
      "id": "reminders",
      "icon": "notifications",
      "title": "Reminders",
      "capabilities": [],
      "tools": [
        "remind_me",
        "list_reminders",
        "cancel_reminder"
      ]
    },
    {
      "id": "storage",
      "icon": "folder",
      "title": "Storage",
      "capabilities": [
        "storage"
      ],
      "tools": [
        "storage_overview",
        "find_files",
        "delete_files",
        "open_app_storage"
      ]
    }
  ],
  "offMessage": "The user turned {{feature}} off in Settings › On this phone, so Whittle can't use it. Tell them, and that they can turn it back on there."
}
